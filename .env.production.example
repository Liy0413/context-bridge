PORT=8787
CONTEXT_BRIDGE_DATA=/app/data/store.json
CONTEXT_BRIDGE_SERVICE_ID=context-bridge-production
CONTEXT_BRIDGE_DOMAIN=bridge.example.com
PUBLIC_BASE_URL=https://bridge.example.com
# Trust exactly one reverse proxy hop (Caddy in docker-compose.public.yml).
TRUST_PROXY=1
# Optional. Enable only when this host also serves trusted LAN clients.
CONTEXT_BRIDGE_LAN_DISCOVERY=0
CONTEXT_BRIDGE_LAN_DISCOVERY_PORT=8788
# Optional bootstrap identities for the first owner. Use long random keys.
CONTEXT_BRIDGE_USERS={"replace-with-a-long-random-owner-key":{"id":"usr_owner","displayName":"Owner"}}
