{
  "description": "Context Bridge semi-automatic checkpoint discovery and publish confirmation.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/context-bridge-semi-auto.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\context-bridge-semi-auto.mjs\"",
            "timeout": 30,
            "additionalContextLimit": 2000,
            "statusMessage": "正在检查 Context Bridge 最新检查点…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/context-bridge-semi-auto.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\context-bridge-semi-auto.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
